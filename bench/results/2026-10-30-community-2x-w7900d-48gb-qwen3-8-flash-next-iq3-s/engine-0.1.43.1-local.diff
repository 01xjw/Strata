+bool conversation_checkpoint_copy(const SessionState& from, SessionState& to, const ModelGeometry& g,
+                                  const std::vector<int32_t>& ids, std::string& error) {
+    ConversationStateSizes z, zt;
+    if (!checkpoint_targets(from, g, ids.size(), z, error) || !checkpoint_targets(to, g, ids.size(), zt, error))
+        return false;
+    if (from.gdn_alloc != to.gdn_alloc || from.qsa_ord0 != to.qsa_ord0 || from.qsa_alloc != to.qsa_alloc ||
+        !from.ple_hist != !to.ple_hist || z.gdn != zt.gdn)
+        return fail(error, "running-state copy between different session carves");
+    if (!sync(error)) return false;
+    auto enqueue = [&](void* dst, const void* src, size_t bytes) {
+        if (!bytes) return true;
+        if (!dst || !src) return fail(error, "missing running-state buffer");
+        const auto status = conversation_detail::copy_enqueue(dst, src, bytes);
+        if (status == cudaSuccess) return true;
+        error = std::string("conversation snapshot running-state copy: ") + cudaGetErrorString(status);
+        return false;
+    };
+    if (!enqueue(to.gdn_state, from.gdn_state, z.gdn) ||
+        !enqueue(to.ple_hist, from.ple_hist, to.ple_hist ? z.ple : 0)) return false;
+    const size_t row = ids.size() / strata::kernels::qsa_real_shapes().idx_block;
+    for (size_t j = 0; j < owned_qsa(to); ++j) {
+        const auto& s = owned(from, j);
+        const auto& d = owned(to, j);
+        if (!enqueue(d.idx_tail, s.idx_tail, z.tail) || !enqueue(d.idx_dead, s.idx_dead, z.dead) ||
+            !enqueue(d.idx_block_pos, s.idx_block_pos, z.block_pos)) return false;
+        if (!ids.empty() && !enqueue(d.idx_pooled + row * g.idx_key_dim, s.idx_dead, z.dead)) return false;
+    }
+    if (const auto status = conversation_detail::copies_wait(); status != cudaSuccess) {
+        error = std::string("conversation snapshot running-state copy: ") + cudaGetErrorString(status);
+        return false;
+    }
+    const size_t tokens = ids.size();
+    to.ple_prev[0] = tokens >= 2 ? ids[tokens - 2] : -1;
+    to.ple_prev[1] = tokens >= 1 ? ids[tokens - 1] : -1;
+    return true;
+}
